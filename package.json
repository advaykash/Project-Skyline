{
  "name": "orbitwatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OrbitWatch \u2014 satellite tracking and orbital visualization on genuine CelesTrak GP data with SGP4 propagation.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788 --ip 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "snapshot:build": "node scripts/build-snapshot.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "preview:full": "npm run build && wrangler pages dev dist --port 8788 --ip 0.0.0.0",
    "test:e2e:resilience": "node tests/e2e/resilience.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satellite.js": "^6.0.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.11.0",
    "puppeteer-core": "^23.6.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.0.0"
  }
}
